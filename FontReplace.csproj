<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">false</DeployOnBuild>
    <Configurations>Debug;Release;Debug-4.1;Debug-4.0;Debug-3.11;Release-4.1;Release-4.0;Release-3.11</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' Or '$(Configuration)' == 'Debug-4.1' Or '$(Configuration)' == 'Release-4.1'">
    <GameVersionPath Condition="'$(GameVersionPath)' == '' And Exists('V:\EFToffline\EFToffline - 4.1debug')">V:\EFToffline\EFToffline - 4.1debug</GameVersionPath>
    <DefineConstants>$(DefineConstants);GAME_4_1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug-4.0' Or '$(Configuration)' == 'Release-4.0'">
    <GameVersionPath Condition="'$(GameVersionPath)' == '' And Exists('V:\EFToffline\EFToffline - 4.0debug')">V:\EFToffline\EFToffline - 4.0debug</GameVersionPath>
    <DefineConstants>$(DefineConstants);GAME_4_0</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug-3.11' Or '$(Configuration)' == 'Release-3.11'">
    <GameVersionPath Condition="'$(GameVersionPath)' == '' And Exists('V:\EFToffline\EFToffline - 3.11.0debug')">V:\EFToffline\EFToffline - 3.11.0debug</GameVersionPath>
    <DefineConstants>$(DefineConstants);GAME_3_11</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameVersionPath)' != ''">
    <GamePluginPath>$(GameVersionPath)\BepInEx\plugins\FontReplace</GamePluginPath>
    <PackagePluginPath Condition="'$(PackagePluginPath)' == '' And Exists('V:\EFToffline\汉化\FontReplace 中文字体切换【开发】\打包')">V:\EFToffline\汉化\FontReplace 中文字体切换【开发】\打包\BepInEx\plugins\FontReplace</PackagePluginPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameVersionPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameVersionPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameVersionPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameVersionPath" BeforeTargets="ResolveReferences" Condition="'$(GameVersionPath)' == ''">
    <Error Text="GameVersionPath is not configured. Pass -p:GameVersionPath=&quot;path to the target EFT/SPT installation&quot;." />
  </Target>

  <Target Name="CopyBuildOutputToGame" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true' And '$(GamePluginPath)' != ''">
    <MakeDir Directories="$(GamePluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePluginPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuildOutputToPackage" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true' And '$(PackagePluginPath)' != ''">
    <MakeDir Directories="$(PackagePluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackagePluginPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
